	<key>PayloadDisplayName</key>
	<string>Edge: macOS DNS</string>
	<key>PayloadDescription</key>
	<string>Turns off Edge's built-in DNS client, so Edge resolves names through macOS like Safari does. Edge's own client kept failing after the Mac had slept for days, until Ethernet was turned off and on.</string>
	<key>PayloadIdentifier</key>
	<string>net.mcsumzhomelab.edge-system-dns</string>
